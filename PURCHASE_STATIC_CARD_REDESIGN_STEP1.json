  "purchase_random_html": "\n        <div class=\"card purchase-card-random purchase-card-support\" onclick=\"selectCardDetail(\" 北國奧援\",'purchase',false)\"=\"\" ondblclick=\"sendAction('buy_card',{index:6})\">\n          \n    <div class=\"card-face card-color-support compact\">\n      <div class=\"card-face-top\">\n        <div class=\"purchase-card-title\">北國奧援</div>\n        \n      </div>\n      <div class=\"card-face-meta-row\">奧援｜特殊</div>\n      <div class=\"purchase-card-body card-effect-block\">\n        <div>奧援卡，依區域主導者判定 I・II・III 級效果。</div>\n      </div>\n      \n      <div class=\"card-badges \"><span class=\"card-badge\">隨機購買區</span></div>\n    </div>\n        </div>\n        <div class=\"card purchase-card-random\" onclick=\"selectCardDetail(\" 領導\",'purchase',false)\"=\"\" ondblclick=\"sendAction('buy_card',{index:7})\">\n          \n    <div class=\"card-face  compact\">\n      <div class=\"card-face-top\">\n        <div class=\"purchase-card-title\">領導</div>\n        \n      </div>\n      <div class=\"card-face-meta-row\">隨機購買區</div>\n      <div class=\"purchase-card-body card-effect-block\">\n        <div>（暫無資料）</div>\n      </div>\n      \n      <div class=\"card-badges \"><span class=\"card-badge\">隨機購買區</span></div>\n    </div>\n        </div>\n        <div class=\"card purchase-card-random purchase-card-support\" onclick=\"selectCardDetail(\" 臺灣奧援\",'purchase',false)\"=\"\" ondblclick=\"sendAction('buy_card',{index:8})\">\n          \n    <div class=\"card-face card-color-support compact\">\n      <div class=\"card-face-top\">\n        <div class=\"purchase-card-title\">臺灣奧援</div>\n        \n      </div>\n      <div class=\"card-face-meta-row\">奧援｜特殊</div>\n      <div class=\"purchase-card-body card-effect-block\">\n        <div>奧援卡，依區域主導者判定 I・II・III 級效果。</div>\n      </div>\n      \n      <div class=\"card-badges \"><span class=\"card-badge\">隨機購買區</span></div>\n    </div>\n        </div>\n        <div class=\"card purchase-card-random purchase-card-support\" onclick=\"selectCardDetail(\" 歐洲奧援\",'purchase',false)\"=\"\" ondblclick=\"sendAction('buy_card',{index:9})\">\n          \n    <div class=\"card-face card-color-support compact\">\n      <div class=\"card-face-top\">\n        <div class=\"purchase-card-title\">歐洲奧援</div>\n        \n      </div>\n      <div class=\"card-face-meta-row\">奧援｜特殊</div>\n      <div class=\"purchase-card-body card-effect-block\">\n        <div>奧援卡，依區域主導者判定 I・II・III 級效果。</div>\n      </div>\n      \n      <div class=\"card-badges \"><span class=\"card-badge\">隨機購買區</span></div>\n    </div>\n        </div>\n        <div class=\"card purchase-card-random purchase-card-support\" onclick=\"selectCardDetail(\" 印度奧援\",'purchase',false)\"=\"\" ondblclick=\"sendAction('buy_card',{index:10})\">\n          \n    <div class=\"card-face card-color-support compact\">\n      <div class=\"card-face-top\">\n        <div class=\"purchase-card-title\">印度奧援</div>\n        \n      </div>\n      <div class=\"card-face-meta-row\">奧援｜特殊</div>\n      <div class=\"purchase-card-body card-effect-block\">\n        <div>奧援卡，依區域主導者判定 I・II・III 級效果。</div>\n      </div>\n      \n      <div class=\"card-badges \"><span class=\"card-badge\">隨機購買區</span></div>\n    </div>\n        </div>",
