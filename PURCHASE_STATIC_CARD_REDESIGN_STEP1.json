{
  "detail_html": "<div class=\"card-detail-placeholder\">點選購買區或手牌卡牌後，可在此查看詳細資訊。</div>",
  "purchase_static_html": "\n        <div class=\"card purchase-card-static\" onclick=\"selectCardDetail(\" 宣傳家\",'purchase',true)\"=\"\">\n          \n    <div class=\"card-face  compact\">\n      <div class=\"card-face-top\">\n        <div class=\"purchase-card-title\">宣傳家</div>\n        \n      </div>\n      <div class=\"card-face-meta-row\">常設購買區</div>\n      <div class=\"purchase-card-body card-effect-block\">\n        <div>（暫無資料）</div>\n      </div>\n      \n      <div class=\"card-badges \"><span class=\"card-badge\">常設購買區</span></div>\n    </div>\n        </div>\n        <div class=\"card purchase-card-static\" onclick=\"selectCardDetail(\" 思想家\",'purchase',true)\"=\"\">\n          \n    <div class=\"card-face  compact\">\n      <div class=\"card-face-top\">\n        <div class=\"purchase-card-title\">思想家</div>\n        \n      </div>\n      <div class=\"card-face-meta-row\">常設購買區</div>\n      <div class=\"purchase-card-body card-effect-block\">\n        <div>（暫無資料）</div>\n      </div>\n      \n      <div class=\"card-badges \"><span class=\"card-badge\">常設購買區</span></div>\n    </div>\n        </div>\n        <div class=\"card purchase-card-static\" onclick=\"selectCardDetail(\" 資助者\",'purchase',true)\"=\"\">\n          \n    <div class=\"card-face  compact\">\n      <div class=\"card-face-top\">\n        <div class=\"purchase-card-title\">資助者</div>\n        \n      </div>\n      <div class=\"card-face-meta-row\">常設購買區</div>\n      <div class=\"purchase-card-body card-effect-block\">\n        <div>（暫無資料）</div>\n      </div>\n      \n      <div class=\"card-badges \"><span class=\"card-badge\">常設購買區</span></div>\n    </div>\n        </div>\n        <div class=\"card purchase-card-static\" onclick=\"selectCardDetail(\" 資本家\",'purchase',true)\"=\"\">\n          \n    <div class=\"card-face  compact\">\n      <div class=\"card-face-top\">\n        <div class=\"purchase-card-title\">資本家</div>\n        \n      </div>\n      <div class=\"card-face-meta-row\">常設購買區<