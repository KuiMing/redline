# Python cache / local tooling
__pycache__/
*.py[cod]
.pytest_cache/

# Local logs
*.log
server.log

# OS/editor noise
.DS_Store
.idea/
.vscode/

# Runtime card art is generated/integrated separately; existing tracked assets remain tracked.
/static/card-art/

# Root-level ad-hoc screenshots/previews should be moved to docs/records/<topic>/
/*.png
/*.webp
/*.jpg
/*.jpeg

# Local scratch / generated artifacts that should not sit uncommitted in repo root
/sketches/
/scripts/debug_analyze_card_ui_report.py
/scripts/generate_era_structured.py
playthrough_screens/

# Full auto-playthrough proof runs (scripts/validate_browser_full_playthrough.py) generate a
# fresh, large batch of screenshots every run; keep them local instead of committing each run.
/docs/records/full-playthrough/

# Card-art design review assets (large image sets, never meant for version control).
/docs/records/design/card-art/
